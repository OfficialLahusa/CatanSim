<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	 <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The MCTS agent and the parallel rollouts allocate on all cores; with the workstation GC the search runs ~30% slower -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.78.0" />
    <PackageReference Include="Saffron.Util.ImGuiSFML" Version="1.3.0" />
    <PackageReference Include="SFML.Net" Version="2.5.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <!-- The files the client loads at runtime, next to the executable (res/ also holds the icon sources and the atlas project) -->
  <ItemGroup>
    <None Include="res\atlas.png;res\*.wav;res\Open_Sans\OFL.txt;res\Open_Sans\static\OpenSans-*.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agents\Agents.csproj" />
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\Simulation\Simulation.csproj" />
  </ItemGroup>

</Project>
